<launch>
    <node pkg="segmentation" type="segmentation" name="detector" output="screen">
    <rosparam command="load" file="$(find segmentation)/config/extrinsic.yaml" />
    <param name="map_path" type="string" value="/home/tjurm/navi_ws/Sentry25NAVI/src/Point-LIO-master/PCD/2floor.pcd"/> 
    <param name="freq" type="int" value="20"/> 
    <param name="distance_threshold" type="double" value="0.2"/> 
    <param name="leaf_size" type="double" value="0.02"/>
    <param name="/use_sim_time" value="flase" />
    <param name="prior_map_pub_en" type="bool" value="true"/>
    <param name="use_livox_cloud" type="bool" value="false"/>
    <param name="diverge_threshold" type="double" value="0.4"/>
    <param name="debug_en" type="bool" value="false"/>
    <param name="use_stl_cloud" type="bool" value="false"/>
    <param name="lidar_height" type="double" value="0.145"/>
    <param name="lidar_roll" type="double" value="-0.349"/>
    </node>
</launch>