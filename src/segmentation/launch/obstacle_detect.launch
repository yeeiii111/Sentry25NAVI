<launch>
    <node pkg="segmentation" type="segmentation" name="detector" output="screen" launch-prefix="xterm -e gdb -ex run --args" >
    <rosparam command="load" file="$(find segmentation)/config/extrinsic.yaml" />
    <param name="map_path" type="string" value="/home/tjurm/navi_ws/Sentry25NAVI/src/Point-LIO-master/PCD/505.pcd"/> 
    <param name="ground_path" type="string" value="/home/tjurm/navi_ws/Sentry25NAVI/src/Point-LIO-master/PCD/505.pcd"/> 
    <param name="freq" type="int" value="20"/> 
    <param name="distance_threshold" type="double" value="0.1"/> 
    <param name="costmap_distance_threshold" type="double" value="0.05"/> 
    <param name="leaf_size" type="double" value="0.1"/>
    <param name="/use_sim_time" value="flase" />
    <param name="prior_map_pub_en" type="bool" value="true"/>
    <param name="use_livox_cloud" type="bool" value="false"/>
    <param name="diverge_threshold" type="double" value="1"/>
    <param name="debug_en" type="bool" value="false"/>
    <param name="use_stl_cloud" type="bool" value="false"/>
    <param name="lidar_height" type="double" value="0.32"/>
    <param name="lidar_y" type="double" value="0.189"/>
    <param name="lidar_roll" type="double" value="0.349"/>
    <param name="box_size" type="double" value="3.5"/>
    <param name="max_dist_sq" value="2.0"/>
    <param name="num_threads" value="8"/>
    <param name="max_iterations" value="100"/>
    </node>
</launch>

<!-- launch-prefix="valgrind" -->